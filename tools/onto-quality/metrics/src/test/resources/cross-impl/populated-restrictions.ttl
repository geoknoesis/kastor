@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix : <http://example.org/cross/pop#> .

# Hand-computed expected OQuaRE values live in CrossImplementationCalibrationTest.

:Animal a owl:Class ;
    rdfs:label "Animal" ;
    rdfs:comment "A living organism." .

:Dog a owl:Class ;
    rdfs:subClassOf :Animal ;
    rdfs:label "Dog" .

:Cat a owl:Class ;
    rdfs:subClassOf :Animal .

:Owner a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :owns ; owl:someValuesFrom :Animal ] .

:owns a owl:ObjectProperty ;
    rdfs:domain :Owner ;
    rdfs:range :Animal .

:name a owl:DatatypeProperty ;
    rdfs:domain :Animal .

# Annotation triples and imports must not count as relationships.
:note a owl:AnnotationProperty .

:rex a :Dog .
:tom a :Cat .
:felix a :Cat .

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix : <http://example.org/zoo#> .

<> a owl:Ontology .

:Animal a owl:Class .
:Lion a owl:Class ;
  rdfs:subClassOf :Animal .

:Animal rdfs:subClassOf :Lion .

:StrayDog rdfs:subClassOf :Animal .

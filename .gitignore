# Kastor — project-specific ignores. Patterns starting with "/" are anchored at the repository root;
# directory patterns without "/" deliberately match at any depth.

# --- Gradle / Kotlin build output -----------------------------------------------------------------
.gradle/
build/
.kotlin/
out/
# Eclipse / VS Code Kotlin compiler mirrors inside modules (e.g. rdf/sparql/lang/bin/)
bin/
local.properties

# --- Test and conformance data (fetched or generated; never committed) -----------------------------
# Pinned W3C corpora: python scripts/fetch-conformance-data.py
/rdf/conformance/test-data/
/rdf/shacl/validation/test-data/w3c-shacl12/
/rdf/shacl/validation/test-data/data-shapes-test-suite/
/w3c-shacl12-fixture/
# Native RDF4J/TDB store written by rdf/examples
/rdf/examples/test-data/
*-conformance-out.txt
# Ad-hoc model / tokenizer downloads
/.tmp-model/

# --- JVM diagnostics and logs -----------------------------------------------------------------------
*.log
hs_err_pid*.log
replay_pid*.log
replay_pid*.txt
*.hprof
*.dump
*.dmp

# --- Documentation site (docs/ is built by Jekyll) -------------------------------------------------
/docs/_site/
/docs/.jekyll-cache/
/docs/.jekyll-metadata
/docs/.sass-cache/
/docs/.bundle/
/docs/vendor/

# --- Python tooling (scripts/) -----------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/

# --- IDEs and local agent tooling -------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
.factorypath
.cursor/
.claude/
.trunk/
*.swp
*~

# --- OS files ---------------------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- Secrets ------------------------------------------------------------------------------------------------
.env
.env.*
